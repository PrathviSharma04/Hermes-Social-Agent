# Application Environment
APP_ENV=development
APP_LOG_LEVEL=INFO
APPROVAL_MODE=REQUIRED
AUTOPILOT_ENABLED=false
PUBLISHING_ENABLED=false
ALLOW_PAID_APIS=false

# Database & Local Storage
DATABASE_PATH=./data/hermes_social.db
TIMEZONE=Asia/Kolkata

# Google Sheets Integration
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Telegram Command Center
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Publishing Controls
PUBLISHING_DRY_RUN=false

# Platform Credentials - LinkedIn
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Platform Credentials - Instagram
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Platform Credentials - X (Twitter)
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Local Obsidian Vault & Asset Storage
OBSIDIAN_VAULT_PATH=
ASSET_PATH=./data/assets
